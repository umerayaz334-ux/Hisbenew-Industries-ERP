# Public domain that will open the ERP, for example:
# CORS_ALLOW_ORIGINS=https://erp.yourdomain.com
CORS_ALLOW_ORIGINS=

# Leave blank when the frontend and backend run on the same domain.
# Set only if the API is hosted elsewhere, for example:
# VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=

# Local port exposed by Docker on the server.
HOST_PORT=8000

# Production PostgreSQL. Use URL-safe characters in the password because it is
# inserted into DATABASE_URL by Docker Compose.
POSTGRES_DB=hisbenew_erp
POSTGRES_USER=hisbenew
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password

# Four API workers with 10 pooled + 5 overflow connections each stays below
# PostgreSQL's usual 100-connection default while allowing request bursts.
WEB_CONCURRENCY=4
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30

# Secret used to sign access tokens. Set a permanent value in production.
SECRET_KEY=replace-with-a-secure-random-string

# Required for Amazon SP-API credentials saved in Amazon Settings.
# Generate one with: cd backend && python -m app.integrations.amazon.configure
# Keep the same value if you move an existing encrypted Amazon database to a new server.
AMAZON_CREDENTIALS_ENCRYPTION_KEY=

# Length of time in minutes before tokens expire.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional WebRTC STUN/TURN servers for ERP voice calls. Keep the JSON on one line.
# For reliable calls across restrictive networks, point this at your own TURN server.
# INTERNAL_CALL_ICE_SERVERS=[{"urls":"stun:turn.yourdomain.com:3478"},{"urls":"turn:turn.yourdomain.com:3478","username":"erp","credential":"replace-me"}]

# Optional local data override. The portable Windows launcher sets these
# automatically so database/uploads/settings stay inside this ERP folder.
# APP_DATA_DIR=D:/Factory Software/Hisbenew Industries ERP/backend
# STATIC_DIR=D:/Factory Software/Hisbenew Industries ERP/backend/static
# FRONTEND_DIST_DIR=D:/Factory Software/Hisbenew Industries ERP/frontend/dist
